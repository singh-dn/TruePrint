# Supabase project settings. Keep the service role key server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private Supabase Storage bucket used by the homepage project intake upload.
SUPABASE_STORAGE_BUCKET=trueprint-requirement-files

# Optional upload limit in bytes. Defaults to 8 MB when omitted.
SUPABASE_MAX_UPLOAD_BYTES=8388608

# Cloudflare Turnstile. The site key is public and must be present during the client build.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Keep the secret key server-side only.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Optional comma-separated hostname allowlist. Defaults to the request hostname.
TURNSTILE_ALLOWED_HOSTNAMES=your-domain.example
